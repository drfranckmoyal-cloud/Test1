{
  "tasks": [
    {
      "id": 1,
      "name_fr": "Informations personnelles",
      "can_do": [
        "comprendre des questions simples sur nom, nationalité, âge, sexe, goûts, habitudes, identité, famille, amis et compétences",
        "poser et répondre à ces questions",
        "se présenter simplement",
        "reconnaître ces informations dans des supports courts"
      ]
    },
    {
      "id": 2,
      "name_fr": "Informations sur un événement",
      "can_do": [
        "comprendre et demander date, heure, lieu, position, participants et numéros",
        "répondre et présenter brièvement ces informations"
      ]
    },
    {
      "id": 3,
      "name_fr": "Informations sur des objets",
      "can_do": [
        "nommer des objets courants",
        "demander/répondre sur taille, quantité, qualité, ancien/nouveau",
        "décrire simplement un objet"
      ]
    },
    {
      "id": 4,
      "name_fr": "Météo",
      "can_do": [
        "comprendre et demander chaud/froid, beau/mauvais temps, pluie/neige",
        "décrire simplement la météo et exprimer une préférence"
      ]
    },
    {
      "id": 5,
      "name_fr": "Environnement et lieux",
      "can_do": [
        "comprendre/demander des informations simples sur école, cinéma, supermarché et autres lieux",
        "décrire taille, qualité, position et préférence"
      ]
    },
    {
      "id": 6,
      "name_fr": "Interactions quotidiennes",
      "can_do": [
        "saluer, remercier, s’excuser, prendre congé",
        "faire une demande simple, demander de l’aide, choisir, téléphoner",
        "exprimer un besoin ou une humeur simple"
      ]
    },
    {
      "id": 7,
      "name_fr": "Alimentation et préférences",
      "can_do": [
        "comprendre et demander intentions de repas, personnes, aliments, horaires et lieux",
        "présenter ses préférences et quelques habitudes alimentaires",
        "reconnaître des aliments courants"
      ]
    },
    {
      "id": 8,
      "name_fr": "Déplacements",
      "can_do": [
        "comprendre/demander mode, heure et destination",
        "présenter un déplacement simple",
        "demander/confirmer un lieu",
        "lire des informations de transport simples"
      ]
    },
    {
      "id": 9,
      "name_fr": "Achats",
      "can_do": [
        "comprendre nom et prix d’un produit",
        "demander prix/disponibilité",
        "exprimer une intention d’achat",
        "présenter nom et prix d’un achat"
      ]
    },
    {
      "id": 10,
      "name_fr": "Maladie et visite",
      "can_do": [
        "dire qu’on est malade et vouloir consulter",
        "comprendre des conseils simples sur manger/dormir/repos",
        "exprimer une intention de rendre visite et réconforter"
      ]
    },
    {
      "id": 11,
      "name_fr": "Loisirs",
      "can_do": [
        "comprendre/demander les loisirs et leur organisation",
        "présenter ses goûts et activités de loisir"
      ]
    },
    {
      "id": 12,
      "name_fr": "Études",
      "can_do": [
        "comprendre/demander école, matière et horaires",
        "présenter simplement sa situation d’apprentissage",
        "lire un emploi du temps simple"
      ]
    },
    {
      "id": 13,
      "name_fr": "École et activités après les cours",
      "can_do": [
        "échanger sur école, professeur, camarades et activités après les cours",
        "présenter ces informations simplement"
      ]
    },
    {
      "id": 14,
      "name_fr": "Travail",
      "can_do": [
        "comprendre/demander métier, lieu, horaires et appréciation",
        "présenter son travail ou celui d’un proche"
      ]
    },
    {
      "id": 15,
      "name_fr": "Alimentation chinoise traditionnelle",
      "can_do": [
        "comprendre/demander des informations simples sur des aliments traditionnels chinois",
        "exprimer ses goûts",
        "reconnaître des items tels que baozi, jiaozi, nouilles et thé"
      ]
    }
  ],
